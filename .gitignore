# --- graphify ---
graphify_/out/
graphify-out/

# --- build ---
# Anchored to the root, all of them: an unanchored "build*/" matches any
# directory whose name starts with build at any depth, and there is one -
# assets/sprites/buildings. Thirty-four building sprites were quietly not in
# the repository because of it, and content loading fails on a fresh clone
# with "no such sprite" rather than with anything that points here.
/build*/
/cmake-build-*/
out/
*.o
*.a
*.so
*.dylib
*.exe

# --- IDE ---
# Run configurations and the CMake profiles are part of the project: they are how
# you launch the game. Everything else CLion writes is local noise.
.idea/*
!.idea/runConfigurations/
!.idea/cmake.xml
.vscode/
.DS_Store

# --- sim artifacts ---
saves/
reports/
!/doc/reports/
/doc/reports/*
!/doc/reports/*.md
!/doc/reports/gen_rework_step_*/
!/doc/reports/gen_rework_step_*/**
!/doc/reports/vg_step_*/
!/doc/reports/vg_step_*/**
!/doc/reports/render_systems_step_*/
!/doc/reports/render_systems_step_*/**
/doc/reports/**/.DS_Store
*.log

# --- IDE and tooling caches ---
.cache/
__pycache__/
*.pyc
.idea/workspace.xml

# Рабочие деревья агентов: копии этого же репозитория, им тут не место.
.claude/worktrees/

# --- generated art ---
# The source maps and packed.json files under assets/terrain are content. The
# baked texture maps and mip levels are reproducible outputs of pack_terrain.py.
/assets/generated/
/assets/retired/
# Poly Haven scene-model sources: reproducible with tools/fetch_models.py from
# content/config/scene_model_sources.json (md5-checked), and hundreds of MB.
/assets/models/polyhaven/
# UE foliage exports (tools/export_ue_foliage.py): not CC0, reproducible from the
# AncientSettlement UE project; hundreds of MB.
/assets/models/ue_foliage/
/assets/terrain/**/*_albedo.png
/assets/terrain/**/*_albedo@*.png
/assets/terrain/**/*_normal.png
/assets/terrain/**/*_normal@*.png
/assets/terrain/**/*_properties.png
/assets/terrain/**/*_properties@*.png
!/assets/terrain/**/src/
!/assets/terrain/**/src/**

# Sprite atlases and screenshots are generated by the extraction/inspection tools.
/assets/sprites/atlases/
/assets/Screenshot *.png
/doc/problems/*.png
/doc/problems/*.mov
/doc/previews/

# --- generated from content/config/terrain (engine/biomes) ---
/assets/shaders/*.gen.hlsli
